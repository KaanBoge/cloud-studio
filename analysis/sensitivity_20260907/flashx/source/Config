# Configuration file for the CloudWind problem: cloud crushing -- a
# supersonic wind strikes a dense, initially static cloud.
# Flash-X port of the FLASH 4.8 CloudCrush problem
# (~/CloudCrushing/FLASH4.8/source/Simulation/SimulationMain/CloudCrush),
# physics matched to the multi-code "cloud-wind matched setup".

REQUIRES Driver
REQUIRES physics/Hydro
REQUIRES physics/Eos/EosMain/Gamma

D sim_pAmbient     Uniform initial pressure (wind and cloud)
PARAMETER sim_pAmbient     REAL    1.0

D sim_rhoAmbient   Density of the wind / ambient medium
PARAMETER sim_rhoAmbient   REAL    1.0

D sim_windVel      Wind inflow velocity (parallel to x-axis)
PARAMETER sim_windVel      REAL    2.582

D sim_rhoCloud     Density of the cloud (chi = sim_rhoCloud/sim_rhoAmbient)
PARAMETER sim_rhoCloud     REAL    10.0

D sim_rCloud       Cloud radius
PARAMETER sim_rCloud       REAL    1.0

D sim_smoothWidth  Width of tanh smoothing at the cloud edge, in units of
D &                sim_rCloud (0 gives a sharp edge)
PARAMETER sim_smoothWidth  REAL    0.1

D sim_rvScale      Radius of the VELOCITY transition, in units of sim_rCloud.
D &                Custom experimental radius, not a numerical stability guarantee.
PARAMETER sim_rvScale      REAL    1.3

D sim_velocityIC   0: sharp boundary; 1: historical tanh velocity, same radius.
PARAMETER sim_velocityIC   INTEGER 0

D sim_xctr         Cloud center x-coordinate
PARAMETER sim_xctr         REAL    0.0

D sim_yctr         Cloud center y-coordinate
PARAMETER sim_yctr         REAL    0.0

D sim_zctr         Cloud center z-coordinate
PARAMETER sim_zctr         REAL    0.0
