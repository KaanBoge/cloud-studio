# ======================================================================
# MATCHED 3D CAMPAIGN, FLASH 4.8, common "level 6", chi = 10
# ======================================================================
# Grid  : uniform 512 (x) x 256 (y) x 256 (z) = 25.6 cells per R_cloud
#         BUILD IS object_l6: NXB=NYB=NZB=32 (not 8 as the level-5 build).
#         root grid Nblockx/y/z = 2/1/1 blocks of 32 cells
#         = 64 x 32 x 32 cells at lrefine 1; lrefine_min = lrefine_max = 4
#         gives 2*2^3 x 1*2^3 x 1*2^3 = 16 x 8 x 8 blocks of 32^3
#         = 512 x 256 x 256 cells.  min == max => FULLY UNIFORM mesh.
#         dx = dy = dz = 2/512 = 0.00390625 (cubic cells)
#
#         PARAMESH tree: 1024 leaf blocks + 146 parents = 1170 total.
#         MEASURED on 8 ranks: min blks 146, max blks 147, tot blks 1170,
#         against MAXBLOCKS=240 -> 63% headroom.  Peak RSS 15.7 GB.
#
#         Why NXB=32 and not the level-5 build's NXB=8: with NGUARD=4 an
#         8^3 block carries 16^3 padded cells (8.0x blowup) and a uniform
#         level-6 tree would need 74,898 blocks = 9,363 per rank, i.e.
#         MAXBLOCKS ~ 10,000 and ~37 GB.  Impossible in 27 GB.  A 32^3
#         block carries 40^3 padded cells (1.95x blowup) and needs only
#         1,170 blocks total.  NXB=16 also fits (9,362 blocks, ~17 GB)
#         but NXB=32 is cheaper in both memory and redundant guard work.
#
# Domain: R_cloud = 0.1 in this code, cloud centre (0.3, 0.5, 0.5), so
#         x in [0,2]   = [-3, 17] R_cloud
#         y in [0,1]   = [-5,  5] R_cloud
#         z in [0,1]   = [-5,  5] R_cloud
# Physics: gamma = 5/3, wind rho = 1, P = 1, vx = 2.582 (Mach 2)
# Cloud  : tanh edge of width 0.1 R_cloud
# Velocity IC: transition at sim_rvScale * R_cloud = 1.3 R_cloud
# Duration: t_cc = sqrt(chi) * R_cloud / v_wind ; tmax = 5 t_cc = 0.612372
# Output : 101 snapshots, plotfileIntervalTime = 0.00612371
#          This is tmax/100 shaved by 1e-8, exactly as at level 5, so the
#          100th trigger lands just below tmax and snapshot 0100 is not
#          lost to floating-point accumulation.  At level 6 dt ~ 4.2e-4,
#          still far larger than the 1e-6 total shave, so snapshot 0100 is
#          written on the step that reaches tmax.
#
# NOTE nrefs: lrefine_min == lrefine_max makes refinement impossible, so
#          the every-2-step refinement check is dead work (measured 4.4 s
#          per step, 5.4% of runtime).  nrefs = 1000000 skips it.
# NOTE rolling_checkpoint: a level-6 checkpoint is 3.5 GB and a plotfile
#          is 805 MB.  101 plotfiles = 81 GB per run.  Keeping only the
#          last 2 checkpoints holds each run to ~88 GB instead of ~120 GB.
#          Checkpoints are restart machinery only; the 101 plotfiles that
#          the cross-code comparison uses are untouched.
# ======================================================================

sim_pAmbient    = 1.0
sim_rhoAmbient  = 1.0
sim_windVel = 2.581988897471611
sim_rhoCloud = 100
sim_rCloud      = 0.1
sim_smoothWidth = 0.1
sim_rvScale = 1.3
sim_xctr        = 0.3
sim_yctr        = 0.5
sim_zctr        = 0.5
gamma = 1.6666666666666667

geometry = "cartesian"
xmin = 0.
xmax = 2.
ymin = 0.
ymax = 1.
zmin = 0.
zmax = 1.
Nblockx = 2
Nblocky = 1
Nblockz = 1

# uniform mesh: min == max forbids both refinement and derefinement
lrefine_min = 2
lrefine_max = 2
refine_var_1 = "dens"
refine_var_2 = "pres"
nrefs = 1000000

xl_boundary_type = "user"      # fixed wind inflow (Grid_applyBCEdge)
xr_boundary_type = "outflow"
yl_boundary_type = "outflow"
yr_boundary_type = "outflow"
zl_boundary_type = "outflow"
zr_boundary_type = "outflow"

cfl     = 0.45
basenm  = "cloudcrush_"
restart = .false.
checkpointFileIntervalTime = 0.001
checkpointFileIntervalStep = 0
checkpointFileNumber       = 0
rolling_checkpoint         = 2
wall_clock_checkpoint      = 43200.
plotfileIntervalTime = 0.001
plotfileIntervalStep = 0
plotfileNumber       = 0
nend = 2
tmax = 0.001
run_comment = "IC verification only, sharp velocity at 1.3 R"
log_file    = "cloudcrush.log"
eintSwitch  = 1.e-4

plot_var_1 = "dens"
plot_var_2 = "pres"
plot_var_3 = "temp"
plot_var_4 = "velx"
plot_var_5 = "vely"
plot_var_6 = "velz"

# Hydro (unsplit solver) - identical to the level-5 matched settings
order            = 3
slopeLimiter     = "mc"
LimitedSlopeBeta = 1.
charLimiting     = .true.
use_avisc        = .true.
cvisc            = 0.1
use_flattening   = .true.
use_steepening   = .false.
use_upwindTVD    = .false.
RiemannSolver    = "HLLC"
entropy          = .false.
shockDetect      = .true.

useSTS           = .false.
nstepTotalSTS    = 5
nuSTS            = 0.2
