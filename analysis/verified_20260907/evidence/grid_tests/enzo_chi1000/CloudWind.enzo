#
# PROBLEM DEFINITION FILE: CloudWind (cloud crushing), 3D, chi=10
# MATCHED 3D SPEC, harmonised 2026-08-25. Twelve-code comparison campaign.
#
#   resolution : level 5 unigrid = 256 x 128 x 128 (12.8 cells per cloud radius)
#   domain     : x in [-3,17] R_cloud, y and z in [-5,5] R_cloud
#   physics    : gamma=5/3, wind rho=1 P=1 vx=2.581989 (Mach 2), R_cloud=1
#   cloud edge : tanh, width 0.1 R
#   velocity   : transition at CloudWindRvScale * R = 1.3 R  (NOT the density edge)
#   duration   : 5 t_cc,  t_cc = sqrt(chi)*R/v_wind
#   output     : 101 snapshots, interval = StopTime/100
#
# t_cc(chi=10) -> StopTime = 6.1237241, dtDataDump = 0.061237241
#
# NOTE: this file is generated whole, never by in-place sed. An earlier chain
# script (a8_chain_3d.sh) truncated it to zero bytes by using the same path as
# both sed input and shell redirect target, which produced the
# "TopGridRank = -99999 ill defined" crash on 2026-08-25.
# A pristine copy is kept alongside as CloudWind.enzo.reference.
#
ProblemType                = 15       // CloudWind
TopGridRank                = 3
TopGridDimensions = 64 32 32
DomainLeftEdge             = -3.0 -5.0 -5.0
DomainRightEdge            = 17.0  5.0  5.0
LeftFaceBoundaryCondition  = 2 1 1    // inflow (wind) on -x, outflow elsewhere
RightFaceBoundaryCondition = 1 1 1    // outflow +x +y +z
#
CloudWindAmbientDensity    = 1.0
CloudWindAmbientPressure   = 1.0
CloudWindVelocity = 2.581988897471611
CloudWindChi = 1000
CloudWindCloudRadius       = 1.0
CloudWindSmoothWidth       = 0.1
CloudWindRvScale           = 1.3      // velocity edge at 1.3 R (Gronnow+2018)
CloudWindCenter            = 0.0 0.0 0.0
CloudWindUseTracer         = 1
#
StopTime = 0.001
dtDataDump = 0.001
DataDumpName               = CW_
StopCycle = 2
#
Gamma = 1.6666666666666667
HydroMethod                = 0        // PPM
CourantSafetyNumber        = 0.4
PPMDiffusionParameter      = 0
PPMFlatteningParameter     = 1
PPMSteepeningParameter     = 1
DualEnergyFormalism        = 0
FluxCorrection             = 1
SelfGravity                = 0
RadiativeCooling           = 0
MultiSpecies               = 0
#
StaticHierarchy            = 1        // unigrid
MaximumRefinementLevel     = 0
